{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MARLIN GAMA single porpoise exchange v2",
  "description": "Engineering boundary contract, not biological approval. Python validation additionally enforces finite numbers, simulation_time_s = step_index * simulation_step_s within 1e-9 s, and per-run ordering/identity. Coordinates are SI metres in MARLIN local Y-up; depth alone controls Y relative to the fixed mean sea plane Y=0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "step_index", "simulation_time_s", "simulation_step_s", "seed", "agents"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "step_index": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "simulation_time_s": {"type": "number", "minimum": 0},
    "simulation_step_s": {"type": "number", "exclusiveMinimum": 0},
    "seed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "agents": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {"$ref": "#/$defs/agent"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$(?![\\s\\S])", "maxLength": 128},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "species", "behavioural_state", "horizontal_position_m", "heading_deg", "speed_mps", "vertical_reference", "depth_m"],
      "properties": {
        "agent_id": {"$ref": "#/$defs/identifier"},
        "species": {"const": "harbour_porpoise"},
        "behavioural_state": {"enum": ["surface", "shallow_swim", "descent", "submerged_swim", "ascent"]},
        "horizontal_position_m": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "heading_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
        "speed_mps": {"type": "number", "minimum": 0},
        "vertical_reference": {"const": "mean_sea_level"},
        "depth_m": {"type": "number", "minimum": 0}
      }
    }
  }
}
