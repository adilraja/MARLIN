{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MARLIN–GAMA state exchange v1",
  "description": "Transport validation only; not biological validation. Coordinates are metres, local Y-up, mean sea plane y=0. The Python validator additionally checks finite numbers, unique IDs and depth/altitude consistency.",
  "type": "object",
  "additionalProperties": false,
  "required": ["time_s", "seed", "agents"],
  "properties": {
    "schema_version": {"const": "1.0", "default": "1.0"},
    "time_s": {"type": "number", "minimum": 0},
    "seed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "agents": {
      "type": "array", "maxItems": 1000,
      "items": {"$ref": "#/$defs/agent"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 128},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "species", "state", "position_m", "heading_deg", "speed_mps"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "species": {"$ref": "#/$defs/identifier"},
        "group_id": {"$ref": "#/$defs/identifier"},
        "state": {"enum": ["surface", "shallow_swim", "dive", "submerged", "ascent", "flying", "gliding", "banking", "descending", "on_water", "takeoff", "landing"]},
        "position_m": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
        "heading_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
        "speed_mps": {"type": "number", "minimum": 0},
        "depth_m": {"type": "number", "minimum": 0},
        "altitude_m": {"type": "number", "minimum": 0}
      }
    }
  }
}
