#usda 1.0
(
    defaultPrim = "Calibration"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "Calibration"
{
    def Mesh "Target" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 1
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </Calibration/Looks/Target>
        point3f[] points = [(-100, 100000, -50), (-100, 100000, 50), (100, 100000, 50), (100, 100000, -50)]
        uniform token subdivisionScheme = "none"
    }

    def "Looks"
    {
        def Material "Target"
        {
            token outputs:surface.connect = </Calibration/Looks/Target/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:emissiveColor = (1, 1, 1)
                float inputs:roughness = 1
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }

        def Material "Background"
        {
            token outputs:surface.connect = </Calibration/Looks/Background/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:roughness = 1
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }

    def Mesh "Background" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 1
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </Calibration/Looks/Background>
        point3f[] points = [(-1536, 99999, -1152), (-1536, 99999, 1152), (1536, 99999, 1152), (1536, 99999, -1152)]
        uniform token subdivisionScheme = "none"
    }

    def Camera "Camera"
    {
        float2 clippingRange = (100, 20000)
        float focalLength = 50
        float fStop = 0
        float horizontalAperture = 5.12
        float horizontalApertureOffset = 0
        token projection = "perspective"
        float verticalAperture = 3.84
        float verticalApertureOffset = 0
        float3 xformOp:rotateXYZ = (-90, 0, 0)
        double3 xformOp:translate = (0, 110000, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}

