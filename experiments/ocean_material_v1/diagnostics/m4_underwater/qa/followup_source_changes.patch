+@router.get('/scene/ocean/material/preset/diagnostic/medium-capabilities',summary='Read registered native medium-related material and schema definitions')
+async def medium_capabilities():
+    from pxr import Plug,Sdr
+    types=[]
+    for plugin in Plug.Registry().GetAllPlugins():
+        for name,metadata in plugin.metadata.get('Types',{}).items():
+            if any(word in name.lower() for word in ('camera','volume','medium')):
+                types.append({'type':name,'plugin':plugin.name,'metadata':metadata})
+    registry=Sdr.Registry()
+    identifiers=[str(x) for x in registry.GetShaderNodeIdentifiers() if any(w in str(x).lower() for w in ('volume','fog'))]
+    return {'ok':True,'native_schema_types':types,'registered_volume_material_identifiers':identifiers,
+            'rtx_settings_tree':str(carb.settings.get_settings().get('/rtx'))}
 
 
