    def Scope "Looks"
    {
        def Material "OceanWater"
        {
            token outputs:mdl:surface.connect = </World/Looks/OceanWater/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniSurface.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniSurface"
                color3f inputs:diffuse_reflection_color = (0.02, 0.1, 0.13)
                float inputs:diffuse_reflection_weight = 0.02
                bool inputs:enable_specular_transmission = 1
                float inputs:metalness = 0
                color3f inputs:specular_reflection_color = (1, 1, 1)
                float inputs:specular_reflection_ior = 1.333
                float inputs:specular_reflection_roughness = 0.045
                float inputs:specular_reflection_weight = 1
                color3f inputs:specular_transmission_color = (0.78, 0.92, 0.95)
                float inputs:specular_transmission_scatter_anisotropy = 0
                color3f inputs:specular_transmission_scattering_color = (0.005, 0.02, 0.03)
                float inputs:specular_transmission_scattering_depth = 100
                float inputs:specular_transmission_weight = 1
                bool inputs:thin_walled = 1
                token outputs:out
            }
        }
    }

    def Xform "Environment"
    {
        def DomeLight "Sky"
        {
            color3f inputs:color = (0.45, 0.65, 1)
            float inputs:exposure = 1
            float inputs:intensity = 500
        }

        def DistantLight "Sun"
        {
            float inputs:angle = 0.53
            color3f inputs:color = (1, 0.92, 0.78)
            float inputs:intensity = 5000
            float3 xformOp:rotateXYZ = (-35, 25, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
    }

