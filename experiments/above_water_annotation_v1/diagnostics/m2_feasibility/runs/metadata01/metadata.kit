[package]
title = "Above-water M2 isolated installed-provider query"
version = "1.0.0"

[dependencies]
"omni.usd" = {}

[settings]
app.content.emptyStageOnStart = false
app.file.ignoreUnsavedOnExit = true
app.settings.persistent = false
app.settings.loadUserConfig = false
app.settings.saveUserConfig = false
app.extensions.registryEnabled = false
app.extensions.syncRegistryOnStartup = false
app.extensions.mkdirExtFolders = false
app.window.enabled = false
privacy.performance = false
privacy.usage = false
telemetry.enableAnonymousData = false
