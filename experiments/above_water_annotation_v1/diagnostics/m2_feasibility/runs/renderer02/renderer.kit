[package]
title = "Above-water M2 isolated renderer lifecycle query"
version = "1.0.0"

[dependencies]
"omni.kit.loop-default" = {}
"omni.usd" = {}
"omni.hydra.rtx" = {}
"omni.kit.viewport.window" = {}
"omni.kit.viewport.utility" = {}
"omni.kit.renderer.capture" = {}
"omni.rtx.settings.core" = {}

[settings]
app.content.emptyStageOnStart = false
app.file.ignoreUnsavedOnExit = true
app.settings.persistent = false
app.settings.loadUserConfig = false
app.settings.saveUserConfig = false
app.extensions.registryEnabled = false
app.extensions.syncRegistryOnStartup = false
app.extensions.mkdirExtFolders = false
app.window.enabled = false
app.viewport.defaults.width = 512
app.viewport.defaults.height = 384
app.viewport.defaults.fillViewport = false
renderer.multiGpu.enabled = false
renderer.gpuEnumeration.glInterop.enabled = false
rtx.ecoMode.enabled = false
privacy.performance = false
privacy.usage = false
telemetry.enableAnonymousData = false
